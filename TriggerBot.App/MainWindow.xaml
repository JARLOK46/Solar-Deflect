<Window x:Class="TriggerBot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solar Deflect" Width="1320" Height="840" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#07120F" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,13" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3B2028" />
            <Setter Property="Foreground" Value="#FFDDE0" />
            <Setter Property="BorderBrush" Value="#74404A" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,13" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="AccentCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentGlowBrush}" />
            <Setter Property="Background" Value="#11231F" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
        <Style x:Key="Subtle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="20" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" CornerRadius="16" Background="{StaticResource CanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="27" Height="27" CornerRadius="8" Background="{StaticResource AccentBrush}">
                            <Grid>
                                <Ellipse Width="13" Height="13" Stroke="#07120F" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="4" Height="4" Fill="#07120F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Line X1="13.5" Y1="3" X2="13.5" Y2="7" Stroke="#07120F" StrokeThickness="1.5" />
                                <Line X1="13.5" Y1="20" X2="13.5" Y2="24" Stroke="#07120F" StrokeThickness="1.5" />
                                <Line X1="3" Y1="13.5" X2="7" Y2="13.5" Stroke="#07120F" StrokeThickness="1.5" />
                                <Line X1="20" Y1="13.5" X2="24" Y2="13.5" Stroke="#07120F" StrokeThickness="1.5" />
                            </Grid>
                        </Border>
                        <TextBlock Text="SOLAR DEFLECT" Margin="11,0,0,0" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="6" Background="{StaticResource SurfaceRaisedBrush}">
                            <TextBlock Text="DESKTOP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Style="{StaticResource WindowButton}" Click="Minimize_Click" FontSize="16" />
                        <Button Content="×" Style="{StaticResource WindowButton}" Click="Close_Click" FontSize="20" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="238" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,15">
                    <Grid Margin="16,25,16,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="MENÚ PRINCIPAL" Style="{StaticResource Eyebrow}" Margin="12,0,0,13" />
                            <Button x:Name="DashboardNav" Tag="Dashboard" Style="{StaticResource NavButton}" Click="Navigation_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="32" FontSize="18" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Panel" FontSize="13" FontWeight="SemiBold"/></StackPanel>
                            </Button>
                            <Button x:Name="SettingsNav" Tag="Settings" Style="{StaticResource NavButton}" Click="Navigation_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="32" FontSize="15" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="Ajustes" FontSize="13"/></StackPanel>
                            </Button>
                            <Button x:Name="MacroNav" Tag="Macro" Style="{StaticResource NavButton}" Click="Navigation_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Width="32" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="Curva macro" FontSize="13"/></StackPanel>
                            </Button>
                            <Button x:Name="SpeedNav" Tag="Speed Test" Style="{StaticResource NavButton}" Click="Navigation_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="32" FontSize="17" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="Prueba de velocidad" FontSize="13"/></StackPanel>
                            </Button>
                            <Button x:Name="HelpNav" Tag="Help" Style="{StaticResource NavButton}" Click="Navigation_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="?" Width="32" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="Ayuda" FontSize="13"/></StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="ESTADO DEL SISTEMA" Style="{StaticResource Eyebrow}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                                        <TextBlock Text="Listo para usar" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Text="La detección solo se activa cuando tú lo indicas." Style="{StaticResource Subtle}"
                                               Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="SOLAR DEFLECT  ·  VERSIÓN DESKTOP" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="9" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="24,22,24,16">
                        <StackPanel>
                            <TextBlock x:Name="SectionTitle" Text="Panel de control" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock x:Name="SectionSubtitle" Text="Configura el objetivo y activa la detección cuando estés listo."
                                       Style="{StaticResource Subtle}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="18" Padding="11,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="SESIÓN LOCAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="34,0,34,28">
                            <!-- Dashboard -->
                            <Grid x:Name="DashboardView">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border x:Name="AlertBanner" Grid.Row="0" Margin="0,0,0,16"
                                        Background="{StaticResource AccentDimBrush}" BorderBrush="{StaticResource AccentGlowBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="13,8" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="AlertText" Text="Listo para configurar" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.88*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource AccentCard}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <StackPanel><TextBlock Text="OBJETIVO DE COLOR" Style="{StaticResource Eyebrow}"/><TextBlock Text="Señal que activará la detección" Style="{StaticResource Subtle}" Margin="0,5,0,0"/></StackPanel>
                                                <Border HorizontalAlignment="Right" Background="{StaticResource AccentDimBrush}" CornerRadius="8" Padding="9,5">
                                                    <TextBlock Text="F6" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,20">
                                                <Border x:Name="TargetColorSwatch" Width="58" Height="58" CornerRadius="14" Background="#B30000"
                                                        BorderBrush="#FFFFFF" BorderThickness="1" />
                                                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TargetColorValue" Text="Sin color seleccionado" Style="{StaticResource ValueText}" FontSize="18" />
                                                    <TextBlock x:Name="ColorStatus" Text="Pulsa Seleccionar color para empezar" Style="{StaticResource Subtle}" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="SELECCIONAR COLOR   ·   F6" Click="SelectColor_Click"
                                                    HorizontalContentAlignment="Center" Style="{StaticResource PrimaryButton}" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid>
                                                <StackPanel><TextBlock Text="PUNTO DE DETECCIÓN" Style="{StaticResource Eyebrow}"/><TextBlock Text="Dónde leer el píxel de pantalla" Style="{StaticResource Subtle}" Margin="0,5,0,0"/></StackPanel>
                                                <Border HorizontalAlignment="Right" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="9,5">
                                                    <TextBlock Text="F7" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,22,0,20" VerticalAlignment="Center">
                                                <TextBlock x:Name="PositionValue" Text="Sigue el cursor" Style="{StaticResource ValueText}" FontSize="20" />
                                                <TextBlock x:Name="PositionStatus" Text="Modo dinámico" Style="{StaticResource Subtle}" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Content="FIJAR POSICIÓN   ·   F7" Click="FixPosition_Click" HorizontalContentAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.88*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="PERFIL DE RESPUESTA" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="Ajustes activos" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,18" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="TOLERANCIA" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="DashboardToleranceValue" Text="30" Style="{StaticResource ValueText}" Margin="0,7,0,0"/></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="DEMORA" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="DashboardClickDelayValue" Text="0.00 s" Style="{StaticResource ValueText}" Margin="0,7,0,0"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="PAUSA" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="DashboardCooldownValue" Text="0.10 s" Style="{StaticResource ValueText}" Margin="0,7,0,0"/></StackPanel>
                                            </Grid>
                                            <TextBlock Text="Personaliza sensibilidad y ritmo desde Ajustes." Style="{StaticResource Subtle}" Margin="0,18,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="MODO DE POSICIÓN" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="Elige cómo seguir el objetivo." Style="{StaticResource Subtle}" Margin="0,5,0,15" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <CheckBox x:Name="PositionLockCheckBox" Checked="PositionLock_Changed" Unchecked="PositionLock_Changed" />
                                                <TextBlock Text="Usar punto fijo" VerticalAlignment="Center" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="Opcional · desactivado por defecto" Style="{StaticResource Subtle}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="3" Margin="0,16,0,0" Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="21">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="DetectorStatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" Margin="0,0,9,0" />
                                                <TextBlock Text="CONTROL DEL DETECTOR" Style="{StaticResource Eyebrow}" />
                                            </StackPanel>
                                            <TextBlock x:Name="DetectorStatusText" Text="En espera" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                                            <TextBlock Text="Actívalo y mantén pulsada la tecla E para permitir la detección." Style="{StaticResource Subtle}" Margin="0,4,18,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="TriggerButton" Grid.Column="1" Content="INICIAR DETECTOR" Style="{StaticResource PrimaryButton}"
                                                Click="ToggleTrigger_Click" Width="210" Height="50" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Settings -->
                            <Grid x:Name="SettingsView" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="AJUSTES DE DETECCIÓN" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Adapta la respuesta a tu pantalla" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,5" />
                                        <TextBlock Text="Los cambios se guardan automáticamente en este dispositivo." Style="{StaticResource Subtle}" Margin="0,0,0,22" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Sensibilidad de color" Style="{StaticResource FieldLabel}" />
                                                <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="100" Value="30" ValueChanged="Settings_ValueChanged" />
                                                <DockPanel Margin="0,5,0,0"><TextBlock Text="Precisa" Style="{StaticResource Subtle}" FontSize="10"/><TextBlock x:Name="ToleranceValue" Text="30 / 100" DockPanel.Dock="Right" Style="{StaticResource Subtle}" FontSize="10"/></DockPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Intervalo de escaneo" Style="{StaticResource FieldLabel}" />
                                                <Slider x:Name="ClickIntervalSlider" Minimum="10" Maximum="1000" Value="100" ValueChanged="Settings_ValueChanged" />
                                                <DockPanel Margin="0,5,0,0"><TextBlock Text="Rápido" Style="{StaticResource Subtle}" FontSize="10"/><TextBlock x:Name="ClickIntervalValue" Text="100 ms" DockPanel.Dock="Right" Style="{StaticResource Subtle}" FontSize="10"/></DockPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Demora antes del clic" Style="{StaticResource FieldLabel}" />
                                                <Slider x:Name="ClickDelaySlider" Minimum="0" Maximum="0.5" Value="0" ValueChanged="Settings_ValueChanged" />
                                                <DockPanel Margin="0,5,0,0"><TextBlock Text="Inmediata" Style="{StaticResource Subtle}" FontSize="10"/><TextBlock x:Name="ClickDelayValue" Text="0.00 s" DockPanel.Dock="Right" Style="{StaticResource Subtle}" FontSize="10"/></DockPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="PAUSA ENTRE DETECCIONES" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="Evita activaciones repetidas demasiado seguidas." Style="{StaticResource Subtle}" Margin="0,6,0,18" />
                                            <Slider x:Name="CooldownSlider" Minimum="0.01" Maximum="0.5" Value="0.1" ValueChanged="Settings_ValueChanged" />
                                            <TextBlock x:Name="CooldownValue" Text="0.10 segundos" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource AccentCard}">
                                        <StackPanel>
                                            <TextBlock Text="POSICIÓN GUARDADA" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="Puedes capturar un punto con F7 y activar el bloqueo desde el panel." Style="{StaticResource Subtle}" Margin="0,7,0,14" TextWrapping="Wrap" />
                                            <TextBlock x:Name="PositionModeValue" Text="Sigue el cursor" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                            <TextBlock x:Name="FixedPositionValue" Text="Punto fijo: no definido" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SPAM DE CLICS" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Mantén R pulsada para hacer clic automáticamente." Style="{StaticResource Subtle}" Margin="0,6,0,12" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <CheckBox x:Name="SpamEnabledCheckBox" IsChecked="True" Checked="SpamEnabled_Changed" Unchecked="SpamEnabled_Changed" />
                                            <TextBlock Text="Permitir spam con R" VerticalAlignment="Center" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Slider x:Name="SpamIntervalSlider" Minimum="10" Maximum="1000" Value="50" ValueChanged="Settings_ValueChanged" />
                                        <DockPanel Margin="0,5,0,0"><TextBlock Text="Más rápido" Style="{StaticResource Subtle}" FontSize="10"/><TextBlock x:Name="SpamIntervalValue" Text="50 ms" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11"/></DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="BOTONES DE ACCIÓN" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Configurá aquí los botones de color y spam." Style="{StaticResource Subtle}" Margin="0,6,0,12" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Botón de color" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="ColorHotkeyTextBox" Text="F6" Padding="8,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Botón de spam" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SpamHotkeyTextBox" Text="R" Padding="8,6" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Admite F5–F12, letras, Space, Enter, Tab, XButton1 y XButton2." Style="{StaticResource Subtle}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap" />
                                        <Button Content="APLICAR BOTONES" Click="ApplyHotkeys_Click" Margin="0,12,0,0" Padding="10,8" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Camera macro -->
                            <Grid x:Name="MacroView" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource AccentCard}">
                                    <StackPanel>
                                        <TextBlock Text="CURVA MACRO" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Giro de cámara de una sola pulsación" FontSize="22" FontWeight="SemiBold" Margin="0,7,0,5" />
                                        <TextBlock Text="Mueve la cámara 180° y vuelve a la posición original. El eje X se calcula con 1.080 / sensibilidad." Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="CONFIGURACIÓN" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Podés cambiar los botones y la sensibilidad sin tocar el resto del detector." Style="{StaticResource Subtle}" Margin="0,6,0,18" TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Botón de curva macro" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="CameraMacroHotkeyTextBox" Text="XButton1" Padding="8,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Sensibilidad" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="CameraMacroSensitivityTextBox" Text="1" Padding="8,6" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Admite F5–F12, letras, Space, Enter, Tab, XButton1 y XButton2." Style="{StaticResource Subtle}" FontSize="10" Margin="0,15,0,0" TextWrapping="Wrap" />
                                        <Button Content="APLICAR CONFIGURACIÓN" Click="ApplyHotkeys_Click" Margin="0,15,0,0" Padding="10,8" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Speed test -->
                            <Grid x:Name="SpeedTestView" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource AccentCard}" Padding="26">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="LABORATORIO DE RESPUESTA" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="Mide tu tiempo de reacción" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,5" />
                                            <TextBlock Text="Diez señales aleatorias. Mantén E pulsada y responde al aparecer la señal." Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="INICIAR 10 PRUEBAS" Style="{StaticResource PrimaryButton}"
                                                Width="190" Height="48" Click="RunSpeedTest_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="MEJOR TIEMPO" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="BestValue" Text="—" Style="{StaticResource ValueText}" FontSize="27" Margin="0,12,0,3"/><TextBlock Text="Tu respuesta más rápida" Style="{StaticResource Subtle}" FontSize="11"/></StackPanel></Border>
                                    <Border Grid.Column="2" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PROMEDIO" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="AverageValue" Text="—" Style="{StaticResource ValueText}" FontSize="27" Margin="0,12,0,3"/><TextBlock Text="Media de las pruebas" Style="{StaticResource Subtle}" FontSize="11"/></StackPanel></Border>
                                    <Border Grid.Column="4" Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="VARIACIÓN" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="DeviationValue" Text="—" Style="{StaticResource ValueText}" FontSize="27" Margin="0,12,0,3"/><TextBlock Text="Desviación estándar" Style="{StaticResource Subtle}" FontSize="11"/></StackPanel></Border>
                                </Grid>
                                <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="CÓMO FUNCIONA" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Una ventana de prueba mostrará un color objetivo tras una espera aleatoria. El detector medirá el tiempo desde la señal hasta el clic registrado." Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Help -->
                            <Grid x:Name="HelpView" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}" Padding="25">
                                    <StackPanel>
                                        <TextBlock Text="INICIO RÁPIDO" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="Configúralo en cuatro pasos" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,20" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontSize="21" FontWeight="Bold"/><TextBlock Text="Elige el color" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Sitúa el cursor y pulsa F6 para capturarlo." Style="{StaticResource Subtle}" TextWrapping="Wrap"/></StackPanel>
                                            <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2"><TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontSize="21" FontWeight="Bold"/><TextBlock Text="Define el punto" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Opcional: guarda una posición fija con F7." Style="{StaticResource Subtle}" TextWrapping="Wrap"/></StackPanel>
                                            <Border Grid.Column="3" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4"><TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontSize="21" FontWeight="Bold"/><TextBlock Text="Ajusta" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Configura sensibilidad y tiempos a tu gusto." Style="{StaticResource Subtle}" TextWrapping="Wrap"/></StackPanel>
                                            <Border Grid.Column="5" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="6"><TextBlock Text="04" Foreground="{StaticResource AccentBrush}" FontSize="21" FontWeight="Bold"/><TextBlock Text="Activa" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Pulsa F5 y mantén E para detectar." Style="{StaticResource Subtle}" TextWrapping="Wrap"/></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ATAJOS DE TECLADO" Style="{StaticResource Eyebrow}" />
                                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Activar / detener" Style="{StaticResource Subtle}"/><Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="F5" FontWeight="Bold" FontSize="10"/></Border></Grid>
                                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Seleccionar color" Style="{StaticResource Subtle}"/><Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="F6" FontWeight="Bold" FontSize="10"/></Border></Grid>
                                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Fijar posición" Style="{StaticResource Subtle}"/><Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="F7" FontWeight="Bold" FontSize="10"/></Border></Grid>
                                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Permitir detección" Style="{StaticResource Subtle}"/><Border Grid.Column="1" Background="{StaticResource AccentDimBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="E" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/></Border></Grid>
                                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Spam de clics" Style="{StaticResource Subtle}"/><Border Grid.Column="1" Background="{StaticResource AccentDimBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="R" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/></Border></Grid>
                                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Macro de cámara" Style="{StaticResource Subtle}"/><Border Grid.Column="1" Background="{StaticResource AccentDimBrush}" CornerRadius="6" Padding="9,4"><TextBlock Text="XButton1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10"/></Border></Grid>
                                            <TextBlock Text="Los botones de color, spam y macro se pueden cambiar desde Ajustes." Style="{StaticResource Subtle}" Margin="0,14,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="CONTROL Y SEGURIDAD" Style="{StaticResource Eyebrow}" />
                                            <Border Background="{StaticResource AccentDimBrush}" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                                                <TextBlock Text="El detector solo actúa cuando está iniciado y mantienes pulsada la tecla E. Puedes detenerlo en cualquier momento con F5." Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
                                            </Border>
                                            <TextBlock Text="La configuración se guarda localmente en este equipo." Style="{StaticResource Subtle}" Margin="0,13,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,15,0" Padding="34,10" Background="{StaticResource SidebarBrush}">
                        <Grid>
                            <TextBlock Text="CONTROL LOCAL · NO SE ENVÍAN DATOS" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Listo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="170,0,160,0" />
                            <TextBlock Text="F5  Iniciar · R  Spam" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
