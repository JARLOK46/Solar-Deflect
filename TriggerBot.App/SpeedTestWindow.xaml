<Window x:Class="TriggerBot.App.SpeedTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reaction Lab" Width="360" Height="260"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#070B11">
    <Border BorderBrush="#2C4050" BorderThickness="1" CornerRadius="14" Background="#0D151E">
        <Grid Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="REACTION LAB" Foreground="#5BE0C5" FontSize="10" FontWeight="Bold"/><TextBlock Text="Hold E and watch the signal" Foreground="#F4F7FA" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
            <Border x:Name="SignalSurface" Grid.Row="1" Margin="0,18,0,18" Background="#05070A" CornerRadius="10" BorderBrush="#1D2B38" BorderThickness="1"><TextBlock x:Name="SignalLabel" Text="WAITING" Foreground="#718296" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/></Border>
            <TextBlock x:Name="TrialLabel" Grid.Row="2" Text="Trial 0 / 10" Foreground="#AAB8C7" FontSize="12" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>