<Window x:Class="TriggerBot.App.SpeedTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solar Deflect · Prueba de reacción" Width="448" Height="340"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" UseLayoutRounding="True">
    <Window.Resources>
        <!-- This window is a separate visual tree, so it needs its own local text style. -->
        <Style x:Key="Subtle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="25,22,25,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentDimBrush}">
                            <TextBlock Text="◷" FontSize="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LABORATORIO DE RESPUESTA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Prueba de reacción" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Mantén E pulsada. Haz clic cuando veas la señal." Style="{StaticResource Subtle}" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="25,18,25,18">
                <Border x:Name="SignalSurface" Background="#05070A" CornerRadius="15"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1">
                    <Grid>
                        <Ellipse Width="100" Height="100" Fill="#16FFFFFF" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="SignalLabel" Text="PREPÁRATE" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="La señal aparecerá aquí" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" FontSize="10" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,17,17" Padding="25,13">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="TrialLabel" Text="Prueba 0 de 10" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="F5 · Cancelar" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
