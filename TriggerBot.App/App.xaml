<Application x:Class="TriggerBot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#0B1017" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111923" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#172230" />
        <SolidColorBrush x:Key="SurfaceInsetBrush" Color="#0A0F15" />
        <SolidColorBrush x:Key="BorderBrush" Color="#263444" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8B4C1" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#718092" />
        <SolidColorBrush x:Key="AccentBrush" Color="#55D6BE" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="#193C3B" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F6C177" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F27D7D" />
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>